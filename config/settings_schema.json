    "theme_documentation_url": "https://github.com/",
    "theme_support_url": "https://github.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logotekst",
        "default": "SØVNIG"
      },
      {
        "type": "text",
        "id": "logo_suffix",
        "label": "Diskret sekundær tekst (fx .dk)",
        "default": ".dk"
      },
      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo-billede (valgfrit)",
        "info": "Hvis valgt, erstatter billedet logoteksten i header og footer."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo-bredde",
        "min": 80,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 140
      }
    ]
  },
