<section class="brand-statement reveal" id="om-somira">
  <div class="container narrow">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="brand-statement-text">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Intro-tekst",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Små ting kan gøre en stor forskel for din aften."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Fra sovemasker og næsestrips til silkeprodukter og andre favoritter. Somira samler produkter, der gør det nemmere at skabe din egen gode aftenrutine.</p>"
    }
  ],
  "presets": [
    {
      "name": "Intro-tekst"
    }
  ]
}
{% endschema %}
