{% comment %}
  Stor "hero-produkt"-sektion (fx Somira Puden). Henter pris og
  tilgængelighed fra et rigtigt Shopify-produkt; overskrift/tekst
  er markedsføringstekst, der kan afvige fra selve produktsidens
  indhold, og sættes separat her.
{% endcomment %}

{%- assign product = section.settings.product -%}

<section class="hero-product">
  <div class="container hero-product-grid">
    <div class="hero-product-media reveal">
      {%- if product and product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 1600 }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy"
          width="1600"
          height="{{ 1600 | divided_by: product.featured_media.aspect_ratio }}">
      {%- elsif section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="1600"
          height="{{ 1600 | divided_by: section.settings.image.aspect_ratio }}">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="hero-product-content reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | upcase }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hero-product-desc">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if product -%}
        <p class="hero-product-price">{% render 'price', product: product %}</p>
        <a href="{{ product.url }}" class="btn btn-primary">{{ section.settings.button_text | upcase }}</a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="usp-list" data-placeholder="true">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}<span class="placeholder-tag">*</span></li>
          {%- endfor -%}
        </ul>
        <p class="placeholder-note">*Foreløbige produktpåstande — bekræftes ved endelig produktspecifikation.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero-produkt",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produkt",
      "info": "Pris og link til \"SE PRODUKTET\"-knappen hentes fra det valgte produkt."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede (bruges kun hvis produktet ikke har et billede)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Lille overskrift",
      "default": "Somira Puden"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Mød puden, der gør sengen svær at forlade."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Blød, hvor du vil have den. Support, hvor du har brug for den. Designet til at give dig følelsen af en god hotelseng, hjemme hos dig selv."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Knap-tekst",
      "default": "Se Somira Puden"
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP (placeholder)",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Premium komfort"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero-produkt",
      "blocks": [
        { "type": "usp", "settings": { "text": "Premium komfort" } },
        { "type": "usp", "settings": { "text": "Tilpasset følelse" } },
        { "type": "usp", "settings": { "text": "Åndbare materialer" } },
        { "type": "usp", "settings": { "text": "30 nætters prøveperiode" } }
      ]
    }
  ]
}
{% endschema %}
