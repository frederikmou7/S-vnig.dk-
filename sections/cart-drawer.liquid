{% comment %}
  Kurv-drawer. Statisk sektion kaldt fra layout/theme.liquid via {% section 'cart-drawer' %}.
  Gen-hentes af assets/cart.js efter add/update/remove via Section Rendering API
  (?section_id=cart-drawer), så indholdet altid matcher Shopifys rigtige cart-objekt.
{% endcomment %}

<div class="cart-overlay" id="cartOverlay"></div>
<aside class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="{{ 'general.cart.title' | t }}" aria-hidden="true">
  <div class="cart-drawer-inner" id="cartDrawerInner">
    <div class="cart-header">
      <h2>{{ 'general.cart.title' | t | upcase }} <span id="cartHeaderCount">({{ cart.item_count }})</span></h2>
      <button class="modal-close" id="cartCloseBtn" aria-label="{{ 'general.cart.title' | t }}">
        {% render 'icon-close' %}
      </button>
    </div>

    {% if settings.cart_show_shipping_bar %}
      {% assign threshold_cents = settings.free_shipping_threshold | times: 100 %}
      <div class="cart-shipping">
        <div class="progress-track">
          <div class="progress-fill" id="progressFill" style="width: {% if cart.total_price >= threshold_cents %}100{% else %}{{ cart.total_price | times: 100.0 | divided_by: threshold_cents }}{% endif %}%"></div>
        </div>
        <p id="shippingMessage">
          {% if cart.total_price >= threshold_cents %}
            {{ 'general.cart.free_shipping_unlocked' | t }}
          {% else %}
            {% assign remaining = threshold_cents | minus: cart.total_price %}
            {% assign remaining_formatted = remaining | money_without_trailing_zeros %}
            {{ 'general.cart.free_shipping_progress_html' | t: amount: remaining_formatted }}
          {% endif %}
        </p>
      </div>
    {% endif %}

    <div class="cart-items" id="cartItems" {% if cart.item_count == 0 %}hidden{% endif %}>
      {% for item in cart.items %}
        {% render 'cart-item', item: item %}
      {% endfor %}
    </div>

    <div class="cart-empty" id="cartEmpty" {% if cart.item_count > 0 %}hidden{% endif %}>
      <p>{{ 'general.cart.empty' | t }}</p>
      <button class="btn btn-outline" id="cartEmptyShopBtn">{{ 'general.cart.continue_shopping' | t | upcase }}</button>
    </div>

    <div class="cart-footer" id="cartFooter" {% if cart.item_count == 0 %}style="display:none"{% endif %}>
      <div class="cart-subtotal">
        <span>{{ 'general.cart.subtotal' | t }}</span>
        <span id="cartSubtotal">{{ cart.total_price | money_without_trailing_zeros }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post" id="cartForm">
        <button type="submit" name="checkout" class="btn btn-primary btn-block" id="checkoutBtn">{{ 'general.cart.checkout' | t | upcase }}</button>
      </form>
      <p class="cart-note">{{ 'general.cart.note' | t }}</p>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Kurv-drawer",
  "settings": []
}
{% endschema %}
