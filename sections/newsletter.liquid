{% comment %}
  Rigtig Shopify customer/newsletter-formular. Intet fake submit —
  bruger {% form 'customer' %} som opretter/tagger en kunde i Shopify.
{% endcomment %}

<section class="newsletter reveal">
  <div class="container narrow">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'NewsletterForm', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail" class="sr-only">{{ 'general.newsletter.placeholder' | t }}</label>
      <input
        type="email"
        name="contact[email]"
        id="NewsletterEmail"
        placeholder="{{ 'general.newsletter.placeholder' | t }}"
        value="{{ form.email }}"
        required>
      <button type="submit" class="btn btn-primary">{{ 'general.newsletter.submit' | t | upcase }}</button>

      {%- if form.posted_successfully? -%}
        <p class="newsletter-message" role="status">{{ 'general.newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="newsletter-message" role="status">
          {%- if form.errors.messages['form'] -%}
            {{ form.errors.messages['form'] }}
          {%- else -%}
            {{ 'general.newsletter.error' | t }}
          {%- endif -%}
        </p>
      {%- else -%}
        <p class="newsletter-message" role="status"></p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Nyhedsbrev",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Små påmindelser om bedre nætter."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Tekst",
      "default": "Nye produkter, gode råd og adgang før alle andre."
    }
  ],
  "presets": [
    {
      "name": "Nyhedsbrev"
    }
  ]
}
{% endschema %}
